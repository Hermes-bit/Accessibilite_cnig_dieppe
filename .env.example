# Domaine de production
DOMAIN=cnig-accessibilite.example.com

# Flask
FLASK_ENV=production
SECRET_KEY=change-me-in-production-32-chars-min
JWT_SECRET_KEY=change-jwt-secret-in-production

# Base de données
DATABASE_URL=postgresql://hermes58:PASSWORD@postgresql-hermes58.alwaysdata.net:5432/hermes58_a4

# Authentification
