# Générer avec : python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('VotreMotDePasse'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

# Redis
REDIS_PASSWORD=change-redis-password

# CORS (séparés par des virgules)
